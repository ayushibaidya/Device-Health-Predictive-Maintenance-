# Safe local demo defaults only. Keep real deployment credentials in untracked .env.
KAFKA_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_GROUP_ID=device-telemetry-validation-v1
POSTGRES_PASSWORD=local-demo-only
# Redis is internal to Compose; host Python can omit REDIS_URL for PostgreSQL-only reads.
LATEST_CACHE_TTL_SECONDS=30
API_PORT=8000
FRONTEND_PORT=3000
