{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 3
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Local C++20 debug build",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "kafka",
      "inherits": "dev",
      "displayName": "C++20 simulator with pinned Kafka publisher",
      "binaryDir": "${sourceDir}/build/kafka",
      "cacheVariables": {
        "DEVICE_HEALTH_WITH_KAFKA": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "kafka",
      "configurePreset": "kafka"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "kafka",
      "configurePreset": "kafka",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
