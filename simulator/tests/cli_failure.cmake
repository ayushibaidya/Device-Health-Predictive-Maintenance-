if(CASE STREQUAL "negative_steps")
    set(arguments --steps -1)
elseif(CASE STREQUAL "overflow_seed")
    set(arguments --seed 4294967296)
elseif(CASE STREQUAL "bad_date")
    set(arguments --start-time 2026-02-29T00:00:00Z)
elseif(CASE STREQUAL "unknown_option")
    set(arguments --unknown 1)
elseif(CASE STREQUAL "missing_value")
    set(arguments --seed)
elseif(CASE STREQUAL "duplicate_option")
    set(arguments --seed 1 --seed 2)
elseif(CASE STREQUAL "nan_speed")
    set(arguments --speed nan)
elseif(CASE STREQUAL "negative_speed")
    set(arguments --speed -1)
elseif(CASE STREQUAL "slow_speed")
    set(arguments --speed 0.5)
elseif(CASE STREQUAL "zero_degradation")
    set(arguments --degradation-units 0)
elseif(CASE STREQUAL "threshold_order")
    set(arguments --warning-threshold 8000)
elseif(CASE STREQUAL "zero_hold")
    set(arguments --recovery-hold-ticks 0)
elseif(CASE STREQUAL "reset_outside")
    set(arguments --steps 2 --reset-at-step 3)
elseif(CASE STREQUAL "clock_overflow")
    set(arguments --start-time 9999-12-31T23:59:59Z --steps 1)
elseif(CASE STREQUAL "zero_reset")
    set(arguments --reset-at-step 0)
elseif(CASE STREQUAL "huge_steps")
    set(arguments --steps 18446744073709551615)
elseif(CASE STREQUAL "skip_states")
    set(arguments --degradation-units 3000)
else()
    message(FATAL_ERROR "Unknown CLI failure test: ${CASE}")
endif()

execute_process(COMMAND "${SIMULATOR}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
if(NOT result STREQUAL "1" OR NOT output STREQUAL "" OR errors STREQUAL "")
    message(FATAL_ERROR "Expected exit 1, empty stdout, and diagnostic stderr; got: ${result} ${output} ${errors}")
endif()
